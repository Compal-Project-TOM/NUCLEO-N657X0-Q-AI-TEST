#n
#nvoid MPU_Config(void)
{
#tuint32_t primask_bit = __get_PRIMASK();
#t__disable_irq();
#n
#t/* Disables the MPU */
#tHAL_MPU_Disable();
#n
#t/* Enables the MPU */
#tHAL_MPU_Enable(__NULL);
#n
#t/* Exit critical section to lock the system and avoid any issue around MPU mechanism */
#t__set_PRIMASK(primask_bit);
#n}
